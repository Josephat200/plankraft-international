/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer-when-downgrade
  Permissions-Policy: geolocation=(), camera=()
  Content-Security-Policy: default-src 'self'; img-src 'self' https: data:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https:; script-src 'self' 'unsafe-inline' https:; frame-src 'self' https://www.google.com https://maps.google.com https://maps.gstatic.com; object-src 'none'; frame-ancestors 'none';
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

/index.html
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache

/*.css
  Cache-Control: public, max-age=86400

/*.js
  Cache-Control: public, max-age=86400

/*.png
  Cache-Control: public, max-age=2592000

/*.jpg
  Cache-Control: public, max-age=2592000

/*.jpeg
  Cache-Control: public, max-age=2592000

/*.webp
  Cache-Control: public, max-age=2592000

/*.gif
  Cache-Control: public, max-age=2592000